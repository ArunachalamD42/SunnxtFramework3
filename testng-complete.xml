<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SunNXT Complete Suite" parallel="none" configfailurepolicy="continue">
    <listeners>
        <listener class-name="listeners.AnnotationTransformer"/>
    </listeners>

    <test name="Onboarding Playback and Subscription" preserve-order="true">
        <classes>
            <class name="userOnboarding.TC_ContentLanguageSelection"/>
            <class name="userOnboarding.TC_UserCreation"/>
            <class name="userOnboarding.TC_Login"/>
            <class name="contentPlayback.TC_PremiumPlayback"/>
            <class name="adsPlayback.TC_AdsSimple"/>
            <class name="sunShorts.TC_SunShortsPlayerControls"/>
            <class name="subscription.TC_SignUpAndSubscribe"/>
        </classes>
    </test>
</suite>
